generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StatusProjeto {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
}

model Projeto {
  id          Int           @id @default(autoincrement())
  nome        String
  descricao   String?
  data_inicio DateTime
  data_fim    DateTime?
  status      StatusProjeto
  usuarios    Usuario[]     @relation("ProjetosUsuarios")
}

model Usuario {
  id       Int       @id @default(autoincrement())
  nome     String
  email    String    @unique
  senha    String
  papel    String
  projetos Projeto[] @relation("ProjetosUsuarios")
  Session  Session?
}

model Session {
  id     Int     @id @default(autoincrement())
  userId Int     @unique
  user   Usuario @relation(fields: [userId], references: [id])
  token  String  @unique @default(uuid())
}
