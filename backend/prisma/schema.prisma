generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StatusProjeto {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
}

model Projeto {
  id          Int           @id @default(autoincrement())
  nome        String
  descricao   String?
  data_inicio DateTime
  data_fim    DateTime?
  created_by  Int           @default(-1)
  creator     Usuario       @relation(fields: [created_by], references: [id])
  status      StatusProjeto
  usuarios    Usuario[]     @relation("ProjetosUsuarios")
  permissions Permissions[] @relation("ProjetoPermissions")
  Logs        Logs[]
}

model Usuario {
  id          Int           @id @default(autoincrement())
  nome        String
  email       String        @unique
  senha       String
  papel       String
  projetos    Projeto[]     @relation("ProjetosUsuarios")
  session     Session?
  permissions Permissions[] @relation("UsuarioPermissions")
  Projeto     Projeto[]
  Logs        Logs[]
}

model Session {
  id     Int     @id @default(autoincrement())
  userId Int     @unique
  user   Usuario @relation(fields: [userId], references: [id])
  token  String  @unique @default(uuid())
}

model Permissions {
  id        Int     @id @default(autoincrement())
  create    Boolean
  delete    Boolean
  update    Boolean
  usuarioId Int
  projetoId Int
  usuario   Usuario @relation("UsuarioPermissions", fields: [usuarioId], references: [id], onDelete: Cascade)
  projeto   Projeto @relation("ProjetoPermissions", fields: [projetoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, projetoId])
}

model Logs {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  projetoId Int
  data      DateTime
  acao      String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  projeto   Projeto  @relation(fields: [projetoId], references: [id])
}
